# Copiar a .env (NO subir .env al repositorio; agregarlo a .gitignore)
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
# True SOLO cuando el sitio ya se sirve por HTTPS (cookies seguras, redirección y HSTS)
DJANGO_HTTPS=False
# IP pública / DNS de la EC2, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA_EC2

# PostgreSQL (en EC2 corre en la misma instancia -> host localhost)
DB_NAME=dulce_arte
DB_USER=dulce_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432

# Origen(es) del frontend si se sirve aparte (el index.html de Django es mismo origen)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://TU_IP_PUBLICA_EC2
